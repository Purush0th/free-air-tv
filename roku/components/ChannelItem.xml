<?xml version="1.0" encoding="utf-8"?>
<!-- One channel-list row (Fire TV item_channel.xml at FHD): number, name, Tamil name below,
     and a glowing dot on the channel playing now. The focused row sits on the white pill the
     list draws underneath, so its text turns dark. -->
<component name="ChannelItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="width" type="float" />
        <field id="height" type="float" />
    </interface>
    <script type="text/brightscript" uri="ChannelItem.brs" />
    <children>
        <Label id="num" translation="[0,0]" width="56" height="96" horizAlign="right" vertAlign="center" color="0x9E9E9EFF">
            <Font role="font" uri="font:SystemFontFile" size="22" />
        </Label>
        <Label id="name" translation="[80,14]" width="320" height="38" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <!-- The Tamil name is a pre-drawn image (see art/labels.js): Roku can't shape Tamil. -->
        <Group translation="[80,50]" clippingRect="[0,0,320,36]">
            <Poster id="locale" blendColor="0xB4B4B4FF" />
        </Group>
        <Poster id="dot" translation="[420,30]" width="36" height="36" uri="pkg:/images/dot.png" visible="false" />
    </children>
</component>
