<?xml version="1.0" encoding="utf-8"?>
<!-- Setting values: accent when on, grey when off (disabled), darker on the white selected row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_enabled="false" android:color="@color/faint_on_selected" />
    <item android:state_selected="true" android:color="@color/accent_on_selected" />
    <item android:state_enabled="false" android:color="@color/faint" />
    <item android:color="@color/accent" />
</selector>
