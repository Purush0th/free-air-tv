<?xml version="1.0" encoding="utf-8"?>
<!-- Picture &amp; Sound panel row: item_setting at 70% text size for the narrow side panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/row_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/row_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- "Shown" in the accent, "Hidden" in grey (disabled state), "New" for an update. -->
    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:duplicateParentState="false"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/row_value"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
