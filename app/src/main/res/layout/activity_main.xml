<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:keepScreenOn="true">

    <!-- The picture, sized to the stream's aspect ratio in code. -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false" />

    <!-- Retrying / paused / no-channels message. -->
    <TextView
        android:id="@+id/status"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/scrim_card"
        android:maxWidth="520dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Connecting: the logo's signal waves pulse outward, with the channel's name below. -->
    <LinearLayout
        android:id="@+id/loader"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/scrim_loader"
        android:gravity="center_horizontal"
        android:minWidth="72dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/loader_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/loader" />

        <TextView
            android:id="@+id/loader_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="120dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Now-watching card after a channel change: compact and translucent.
         Top-left, because Tamil news runs tickers along the bottom. -->
    <LinearLayout
        android:id="@+id/banner"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:background="@drawable/scrim_card"
        android:gravity="center_vertical"
        android:maxWidth="440dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:minWidth="20dp"
            android:textColor="@color/faint"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/banner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/banner_tamil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/live_dot" />

                <TextView
                    android:id="@+id/banner_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/live"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Volume feedback, top right. -->
    <TextView
        android:id="@+id/volume_toast"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="@drawable/scrim_card"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Side nav: the channel list. -->
    <LinearLayout
        android:id="@+id/guide"
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_glass"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <!-- Settings: icon-only, so it carries a spoken label and a strong focus state. -->
            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/icon_on_button" />
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="2dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/list_selector"
            android:nextFocusUp="@id/settings_button"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Player panel: quality, volume, mute. Opens with Right. -->
    <LinearLayout
        android:id="@+id/options"
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_glass"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:text="@string/options_title"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <ListView
            android:id="@+id/options_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="2dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/list_selector"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
