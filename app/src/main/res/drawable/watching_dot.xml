<?xml version="1.0" encoding="utf-8"?>
<!-- Now-watching marker: a turmeric dot with a soft halo and a small highlight.
     Darker on the white focused row so it keeps 3:1 against it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval"><solid android:color="#408A5200" /></shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval"><solid android:color="@color/accent_on_selected" /></shape>
            </item>
            <item android:bottom="10dp" android:left="7dp" android:right="9dp" android:top="6dp">
                <shape android:shape="oval"><solid android:color="#66FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval"><solid android:color="#59F2A93B" /></shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <gradient android:centerX="0.35" android:centerY="0.35" android:endColor="@color/accent"
                        android:gradientRadius="8dp" android:startColor="#FFFFD58A" android:type="radial" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
